# strata-mcp configuration — copy to .env and adjust. ALL values are optional;
# strata-mcp runs with sane defaults and NO external services or API keys.
#
# strata-mcp does NOT use any LLM API key. The reasoning model is Claude Code
# itself (the session, plus Haiku subagents for bulk paper analysis).

# --- Database ---------------------------------------------------------------
# Where the per-research-project SQLite DB lives. Default: ./.strata/strata.db
# relative to the directory the MCP server runs in (= where you launch Claude Code).
# STRATA_DB=./.strata/strata.db

# --- Ingest queue -----------------------------------------------------------
# How many queued papers each /strata run drains (Haiku subagents launched in
# parallel). Read by the /strata command, not the server.
# STRATA_INGEST_BATCH=5
# A "processing" queue item older than this many minutes is considered orphaned
# (its worker died / the session was interrupted) and reset to "pending".
# STRATA_STALE_QUEUE_MINUTES=15
# After this many attempts a queue item is marked permanently failed.
# STRATA_MAX_INGEST_ATTEMPTS=3

# --- Paper fetching ---------------------------------------------------------
# Skip / fail PDFs larger than this (MB) instead of loading them into memory.
# STRATA_MAX_PDF_MB=50
# HTTP timeout (seconds) for arXiv / PDF downloads.
# STRATA_HTTP_TIMEOUT=30
# Optional contact email appended to the User-Agent sent to arXiv (politeness;
# helps avoid rate limiting).
# STRATA_CONTACT_EMAIL=

# --- Repo introspection (v1, optional) --------------------------------------
# Token used to read private repos for the gap/draft "your solution" section.
# If unset, strata-mcp degrades to "no repo introspection" instead of failing.
# GITHUB_TOKEN=

# --- Supabase -> SQLite migration (scripts/migrate_supabase.py, v1, one-shot) -
# SUPABASE_URL=
# SUPABASE_KEY=
